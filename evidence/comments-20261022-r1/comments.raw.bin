 **//*
 * Syscfg module - uses config sector for common filesytem between linux and uboot.
 *//* for copy_from_user *//////////////////////////////////////////////////////////////////////////////////             Definitions////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////          Structures and types////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////          Global Data///////////////////////////////////////////////////////////////////////////////// do flash ops in background//static void bootcfg_do_flash(unsigned long data);//struct tasklet_struct work = { 0, 0, ATOMIC_INIT(0), bootcfg_do_flash, 0};/////////////////////////////////////////////////////////////////////////////////          Functions////////////////////////////////////////////////////////////////////////////////******************************************************************************
   Function:    bootcfg_crc32
   Purpose:     calculate crc for bootcfg area
   Returns:
   Note:
 *****************************************************************************//* keep pushing the commit into the future while updates are arriving *//******************************************************************************
   Function:    bootcfg_store_write
   Purpose:     Writes data to flash device
   Returns:
   Note:        We now do this in deferred mode
 *****************************************************************************//*
	 * TBD: leaving this flag set in the event of a failure will cause subsequent callers to
	 * hang.  A failure indication should be returned to the caller.
	 *//******************************************************************************
   Function:    bootcfg_store_read
   Purpose:     reads data from flash, checks crc and sets valid bit
   Returns:
   Note:        todo: unmap on exit
 *****************************************************************************//* Check CRC *//*
			 * Empty out data. This may be due to corruption,
			 * decompression failure when eeprom is uninitialised,
			 * or a legitimately empty flash... user can override.
			 *//* a restricted number of bytes for storage is available *//******************************************************************************
   Function:    bootcfg_get_var
   Purpose:     Get variable from environment
   Returns:     NULL if variable not found, pointer to storage otherwise
   Note:        variable value copied to storage
 *****************************************************************************/// printk("find %s %d\n",variable,len);// found it, copy and return string// flush to 0, end marked by double 0/******************************************************************************
   Function:    bootcfg_set_var
   Purpose:     Set variable to environment
   Returns:     NULL if variable not found, pointer to storage otherwise
   Note:        variable value copied to storage
 *****************************************************************************/// find the index// found it, delete the entry// flush to next entry// now copy reset of table// flush to 0, end marked by double 0// if we are deleting we are done, otherwise write the new value// flush to end// mark end with double 0// mark end with double 0    }// dump for debug/******************************************************************************
	Function:   bootcfg_get_end
	Purpose:	Get end of data section
 	Returns:	0 if successful
  	Note:  	    if size is zero, the proc entry is created but
  	            no data is allocated until the first write
 *****************************************************************************//******************************************************************************
	Function:   bootcfg_delete
	Purpose:	delete file
 	Returns:	0 if successful
  	Note:
 *****************************************************************************/// figure out our address and len// unmount the file// fix links// error check for null here without finding entry?/******************************************************************************
	Function:   bootcfg_create
	Purpose:	create file
 	Returns:	0 if successful
  	Note:  	    if size is zero, the proc entry is created but
  	            no data is allocated until the first write
 *****************************************************************************///printk("create %s %x\n",filename,size);// need exclusive access now so nobody messes up our allocation process// create our entry// set end marker// make it so - someone else could come in here, but the// flash data structure is intact, so should be ok// add our file into list/******************************************************************************
	Function:   bootcfg_proc_write_env
	Purpose:	write data to boot environment
 	Returns:	Number of bytes written
  	Note:
 *****************************************************************************//* get buffer size *//* write data to the buffer */// create a new file// figure out our address and len// create the file// delete a file// get our filename// default case, we are just setting a variable// update our entry and end of memory marker/******************************************************************************
	Function:   bootcfg_proc_write
	Purpose:	get data from proc file
 	Returns:	Number of bytes written, updates file->f_pos
  	Note:
 *****************************************************************************//* write data to the buffer *//* write to bootcfg data file *///printk("bootcfg: write %s (%x) %d %d [%x]\n",id->entry,id->addr,(int)count,(int)file->f_pos,procfs_buffer[0]);// do we need to increase our size?/* just need to allocate? *//* just need to increase size */// make a copy of our data// remove our current file and defragment// now add our new data//printk("bootcfg: moving %s (%x->%x) %d %d\n",id->entry,id->addr,addr,len,(int)file->f_pos);// make sure we have room for data// revert to flash data and return// copy our original data// update our fs info// offset by 4 to compensate for crc/******************************************************************************
	Function:   bootcfg_get_args
	Purpose:	parse arguments from cfg file entry
	Returns:	filename copied to buffer, addr and len scanned and set
	Note:
 *****************************************************************************/// figure out our addr and len from entry/******************************************************************************
	Function:   bootcfg_defragment
	Purpose:	defragment bootcfg structure
 	Returns:
  	Note:  	    avoid some error checking by assuming data integrity.
  	            hopefully this is a safe assumption
 *****************************************************************************/// first make a copy of the entire buffer// loop through bootcfg file entries// get current addr and len// copy data to new location//printk("bootcfg defrag: moving %s from %x to %x\n",//    filename,addr,end);// save entry in env// update id// error check for null here without finding entry?// not much we can do here other than output a warning// should never happen - this is also engineering mode// only.  Production should never change a file size// or anything more than an ip or mac address, etc.// flush to 0, end marked by double 0// update end of memory pointer/******************************************************************************
	Function:   bootcfg_proc_read
	Purpose:	read data from bootcfg flash area
 	Returns:
  	Note:  	Debug support file - displays register contents
 *****************************************************************************///printk("Proc read offset:%x len:%x\n",offset,buffer_length);// this is env read// we read on one shot// read from file//printk("reading %s (%x) %d %d\n",id->entry,id->addr,(int)offset,buffer_length);// end of file//printk("bootcfg error: len:%d > id->len:%d\n",buffer_length,id->len);/*
			 * procfs has a limitation of one physical page per copy
			 * any buffer that exceeds the limit has to be split
			 *//*
		 * fs/proc/generic.c, L98: the value returned in *buffer_location
		 * has to be smaller than (unsigned long)buffer
		 */// compensate for crc//printk("data: %d %x %x\n",offset,buffer[offset],&gBootCfgData.data[id->addr-4+offset]);/******************************************************************************
	Function:   boardparam_proc_read
	Purpose:	read board paramaters
	Returns:
	Note:
 *****************************************************************************//******************************************************************************
	Purpose:	override linux version to correct not suitable
			here write behaviour (position is not updated after
			write in original version)
