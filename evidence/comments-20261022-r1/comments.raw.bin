#define LHOST_DEBUG_BEACON
#define MUC_DEBUG_BEACON
*//*
 * The paired v37.4.x MuC invalidates a fixed 1000-byte descriptor arena.
 * Keep legacy builds byte-for-byte compatible with the older 512-byte ABI.
 *//*
 * A general ie descriptor shared between sender (LHOST) and receiver (MuC).
 * To avoid issues of alignment compatibility between different hosts, all fields has 32bits
 * aligned.
 *//* MuC reference to the ie buffer *//* LHOST reference to the ie buffer *//* total length of ie including id + len *//* next ie descriptor address presented in MuC addr mapping *//* next ie descriptor *//* __BEACON_IOCTL_H__ *//*SH0
