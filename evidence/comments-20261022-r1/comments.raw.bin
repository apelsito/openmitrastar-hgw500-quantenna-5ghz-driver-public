EH0*/// 10*log10(0) = -infinity//printk("shift = %d , x = %d, lut_1024_10log10[(x >> shift) - 1] = %d \n\n", shift, x, lut_1024_10log10[(x >> shift) - 1]);// y = round((1024*10*log10(x/2^shift) + (shift-nbit_frac_in)*1024*10*log10(2)) / 2^(10-nbit_frac_out))// 49321 = round(16*1024*10*log10(2))//10000/16// se is in [1:32]// MSB mask for 2048// invalid EVM values//printk("reg=%x, man = %d, exp = %d, n_sym=%d\n", evm_array[k], man[k], exp[k], n_sym);// only one stream//log(b+a) - log(a*b)// get log(a + b)// get log(a*b)// 1 time shift 12 bits// log(bc+ab+ac) -log(abc)// get 3 terms product: bc// get 3 terms product: ac// get 3 terms product: ab// check the tiny input cases// min 7 bits for log table// left-shift up to bit 30// get summatioon of t2 terms products: bc + ac +ab// get 3 term products : a*b*c// 2 times shift 12 bits // log(bcd+acd+abd+abc) -log(abcd)// get 3 terms product: bcd// get 3 terms product: acd// get 3 terms product: abd// get 3 terms product: abc// check the tiny input cases// min 7 bits for log table// left-shift up to bit 30// summation of 3 term products : bcd+acd+abd+abc// get 4 terms products : a*b*c*d// 3 times shift 12 bits //printk("sum   = (%d, %d)\n", evm_mant_sum, evm_exp_sum);//printk("prod  = (%d, %d)\n", (int) evm_mant_mul, evm_exp_mul);// fix bug: negative dB shift error//printk("int = %d, frac = %d\n", *evm_int, *evm_frac);//printk("man = %d, exp = %d\n", man, exp);//printk("y = %d, x = %d\n", y, x);// fix bug: negative dB shift error//printk("int = %d, frac = %d\n", *evm_int, *evm_frac);//#ifdef FLOAT_SUPPORT/* autogenerated *//* ARP protocol *//* Appletalk AARP *//* EAPOL PAE/802.1x *//* IP protocol *//* IPv6 protocol *//* IPX over DIX *//* 802.1Q VLAN header *//* 802.1AD VLAN S-TAG header *//* invalid address family *//*
 * IPV4 extra metadata per entry
 * Size derive from ipv4 address[27:23]
 * ipv4[0] is always 0xe followed by 5 bits that define the ipv4
 * table size so in this way we can differentiate between similar multicast mac addresses
 * the other 23 bits assemble the mac multicast id.
 */// __QTN_NET_PACKET_H__/*
 * Copyright (c) 2013 Quantenna Communications, Inc.
 * All rights reserved.
 *//* MUC_BUILD *//* __QTN_PCAP_H__ *//*SH1
