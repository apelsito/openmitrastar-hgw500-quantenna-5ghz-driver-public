+#ifdef CONFIG_OPENMITRASTAR_QDRV_COMPAT
+int openmitrastar_br_fdb_fillbuf(struct net_device *dev,
+		struct openmitrastar_fdb_entry *entries, unsigned long maxnum)
+{
+	const struct net_bridge_port *source;
+	const struct net_bridge_port *dst;
+	struct net_bridge_fdb_entry *fdb;
+	int num = 0;
+
+	if (!dev || !entries || maxnum > INT_MAX ||
+	    maxnum > SIZE_MAX / sizeof(*entries))
+		return -EINVAL;
+
+	memset(entries, 0, maxnum * sizeof(*entries));
+
+	rcu_read_lock();
+	source = br_port_get_rcu(dev);
+	if (!source) {
+		num = -ENODEV;
+		goto out;
+	}
+
+	hlist_for_each_entry_rcu(fdb, &source->br->fdb_list, fdb_node) {
+		if (num >= maxnum)
+			break;
+		if (has_expired(source->br, fdb))
+			continue;
+
+		dst = READ_ONCE(fdb->dst);
+		if (!dst)
+			continue;
+
+		ether_addr_copy(entries[num].mac_addr, fdb->key.addr.addr);
+		entries[num].is_local = test_bit(BR_FDB_LOCAL, &fdb->flags);
+#ifdef CONFIG_WEXT_CORE
+		entries[num].is_wlan = !!dst->dev->wireless_handlers;
+#endif
+		if (!test_bit(BR_FDB_STATIC, &fdb->flags))
+			entries[num].ageing_timer_value =
+				jiffies_delta_to_clock_t(jiffies - READ_ONCE(fdb->updated));
+		num++;
+	}
+out:
+	rcu_read_unlock();
+	return num;
+}
+EXPORT_SYMBOL_GPL(openmitrastar_br_fdb_fillbuf);
+
+void openmitrastar_br_fdb_update_const(struct net_device *dev,
+		const unsigned char *addr, u16 sub_port)
+{
+	struct net_bridge_fdb_entry *fdb;
+	struct net_bridge_port *source;
+
+	if (!dev || !is_valid_ether_addr(addr))
+		return;
+
+	/* Mainline bridge FDBs do not encode Quantenna's hardware sub-port. */
+	(void)sub_port;
+
+	rcu_read_lock();
+	source = br_port_get_rcu(dev);
+	if (!source)
+		goto out;
+
+	br_fdb_update(source->br, source, addr, 0,
+		BIT(BR_FDB_STATIC) | BIT(BR_FDB_ADDED_BY_USER));
+	fdb = br_fdb_find_rcu(source->br, addr, 0);
+	if (fdb) {
+		set_bit(BR_FDB_STATIC, &fdb->flags);
+		set_bit(BR_FDB_ADDED_BY_USER, &fdb->flags);
+	}
+out:
+	rcu_read_unlock();
+}
+EXPORT_SYMBOL_GPL(openmitrastar_br_fdb_update_const);
+#endif /* CONFIG_OPENMITRASTAR_QDRV_COMPAT */
