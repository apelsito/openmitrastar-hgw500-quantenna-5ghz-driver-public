+
+static bool openmitrastar_br_ap_isolate_should_forward(
+		const struct net_bridge_port *p, const struct sk_buff *skb)
+{
+	if (skb->dev == p->dev)
+		return !br_get_ap_isolate() &&
+			!QTN_FLAG_IS_INTRA_BSS(skb->dev->qtn_flags);
+
+	if ((QTN_FLAG_IS_BSS_ISOLATE(skb->dev->qtn_flags) &&
+			(p->dev->qtn_flags & QTN_FLAG_WIFI_DEVICE)) ||
+		((skb->dev->qtn_flags & QTN_FLAG_WIFI_DEVICE) &&
+			QTN_FLAG_IS_BSS_ISOLATE(p->dev->qtn_flags)))
+		return false;
+
+	return true;
+}
